# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# JWT — copy the "JWT Secret" from Supabase → Project Settings → API
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# GenAI microservice URL
GENAI_URL=https://aiops-genai.onrender.com/analyze

# ── Incident detection (threshold-based, NOT AI) ──────────────────────────────
# Number of ERROR logs within the window that triggers an incident.
# Can also be overridden per-project via projects.error_threshold (NULL = use below).
ERROR_THRESHOLD=5

# Sliding window (minutes) for counting errors and for log dedup.
ERROR_WINDOW_MINUTES=5

# Size of the time-bucket (seconds) used for auto-computing idempotency keys.
# Should equal ERROR_WINDOW_MINUTES * 60.
DEDUP_BUCKET_SECONDS=300
